{
  "name": "zcode-tps-monitor-desktop",
  "version": "2.5.0",
  "private": true,
  "description": "StepFun/ZCode token 速率监视器 — Electron 桌面客户端(独立可选分发物,不进插件市场)",
  "author": "Neriah-Ado",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "icons": "node electron/build/make-icons.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage",
    "test": "node --test"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
