{
  "name": "zcode-tps-monitor-desktop",
  "version": "2.5.0",
  "private": true,
  "description": "ZCode 会话级 Token 速率监控插件 —— Electron 桌面客户端：主窗口、悬浮条、托盘与自动更新（独立分发物，不进插件市场）",
  "author": "Neriah-Ado",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "icons": "node electron/build/make-icons.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage",
    "test": "node --test"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
